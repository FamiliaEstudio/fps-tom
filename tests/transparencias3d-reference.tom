SetVarFl32xDistanciay(@Distancia+@P.w)
InSd64ParaInUd64[(@I+6)]
BufferVec4Fl32Ler[@Lista,@ULTIMO]yP
SetVarFl32xDistanciay((@Distancia+@P.w)/3.0)
ParaxJ[1,8,3]
