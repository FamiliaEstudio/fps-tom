ParaxI[@Inicio,@Fim,9]
InSd64ParaInUd64[@I]
BufferVec4Fl32Ler[@Lista,@ULTIMO]
DefVarVec4<Fl32>xPy@ULTIMO
DefVarFl32xDistanciay@P.w
InSd64ParaInUd64[(@I+3)]
