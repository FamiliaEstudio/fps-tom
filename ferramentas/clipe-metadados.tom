Importar[l'../src/clipe3d.tom']
DefFuncaoxFpsClipeCampoJSON[TxtxNome,InSd64xValor,RefTextoxSaida]yVazio
DefStkFB64CxNumeroyl''
InSd64ParaTexto[@Valor,@Numero]
AnexarTxt[@Saida,l'  "']
AnexarTxt[@Saida,@Nome]
AnexarTxt[@Saida,l'": ']
AnexarTxt[@Saida,@Numero]
AnexarTxt[@Saida,l',\n']
FimFuncao

DefFuncaoxFpsClipeJSON[Registro<FpsClipe3D>xClipe,RefTextoxSaida]yVazio
CopiarTxt[@Saida,l'{\n']
ChamarxFpsClipeCampoJSON[l'version',1,@Saida]
ChamarxFpsClipeCampoJSON[l'width',@Clipe.largura,@Saida]
ChamarxFpsClipeCampoJSON[l'height',@Clipe.altura,@Saida]
ChamarxFpsClipeCampoJSON[l'fps',@Clipe.taxa,@Saida]
ChamarxFpsClipeCampoJSON[l'frames',@Clipe.quadros,@Saida]
ChamarxFpsClipeCampoJSON[l'columns',@Clipe.colunas,@Saida]
ChamarxFpsClipeCampoJSON[l'rows',@Clipe.linhas,@Saida]
ChamarxFpsClipeCampoJSON[l'durationSamples',@Clipe.duracaoAmostras,@Saida]
AnexarTxt[@Saida,l'  "audio": ']
Sex@Clipe.audio
AnexarTxt[@Saida,l'true']
Senao
AnexarTxt[@Saida,l'false']
FimSe
AnexarTxt[@Saida,l'\n}\n']
FimFuncao

DefFuncaoxFpsClipeCampoTom[TxtxNome,InSd64xValor,RefTextoxSaida]yVazio
DefStkFB64CxNumeroyl''
InSd64ParaTexto[@Valor,@Numero]
AnexarTxt[@Saida,l'SetVarInSd64xR.']
AnexarTxt[@Saida,@Nome]
AnexarTxt[@Saida,l'y']
AnexarTxt[@Saida,@Numero]
AnexarTxt[@Saida,l'\n']
FimFuncao

DefFuncaoxFpsClipeTom[Registro<FpsClipe3D>xClipe,RefTextoxSaida]yVazio
CopiarTxt[@Saida,l'Importar[l\'../src/clipe3d.tom\']\nDefFuncaoxFpsClipePreparado[]yRegistro<FpsClipe3D>\nDefVarRegistro<FpsClipe3D>xRyPadrao\n']
ChamarxFpsClipeCampoTom[l'largura',@Clipe.largura,@Saida]
ChamarxFpsClipeCampoTom[l'altura',@Clipe.altura,@Saida]
ChamarxFpsClipeCampoTom[l'taxa',@Clipe.taxa,@Saida]
ChamarxFpsClipeCampoTom[l'quadros',@Clipe.quadros,@Saida]
ChamarxFpsClipeCampoTom[l'colunas',@Clipe.colunas,@Saida]
ChamarxFpsClipeCampoTom[l'linhas',@Clipe.linhas,@Saida]
ChamarxFpsClipeCampoTom[l'duracaoAmostras',@Clipe.duracaoAmostras,@Saida]
AnexarTxt[@Saida,l'SetVarBlxR.audioy']
Sex@Clipe.audio
AnexarTxt[@Saida,l'Verdadeiro']
Senao
AnexarTxt[@Saida,l'Falso']
FimSe
AnexarTxt[@Saida,l'\nRetornarx@R\nFimFuncao\n']
FimFuncao
