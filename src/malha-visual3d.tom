// Derivação residente para iluminação por vértice; nenhuma alocação por quadro.
// A física conserva os triângulos canônicos dos mesmos construtores.
Importar[l'./mundo3d.tom']
DefFuncaoxFps3DQuadPonto[Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xD,Fl64xU,Fl64xV]yVec3<Fl64>
Retornarx[(@A.x+(@B.x-@A.x)*@U+(@D.x-@A.x)*@V),(@A.y+(@B.y-@A.y)*@U+(@D.y-@A.y)*@V),(@A.z+(@B.z-@A.z)*@U+(@D.z-@A.z)*@V)]
FimFuncao
DefFuncaoxFps3DTriUV[Vec2<Fl64>xA,Vec2<Fl64>xB,Vec2<Fl64>xC,Fl64xU,Fl64xV]yVec2<Fl64>
Retornarx[(@A.x+(@B.x-@A.x)*@U+(@C.x-@A.x)*@V),(@A.y+(@B.y-@A.y)*@U+(@C.y-@A.y)*@V)]
FimFuncao
DefFuncaoxFps3DVisualTri[RefRegistro<Fps3DMundo>xVisual,RefSOA<FpsTriangulo>xDestino,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC,Vec2<Fl64>xUA,Vec2<Fl64>xUB,Vec2<Fl64>xUC,InSd64xPartes,InSd32xMaterial,InSd32xAndar]yVazio
InSd64ParaFl64[@Partes]
DefVarFl64xTotaly@ULTIMO
ParaxY[0,@Partes,1]
InSd64ParaFl64[@Y]
DefVarFl64xV0y(@ULTIMO/@Total)
DefVarFl64xV1y((@ULTIMO+1.0)/@Total)
DefVarInSd64xColunasy(@Partes-@Y)
ParaxX[0,@Colunas,1]
InSd64ParaFl64[@X]
DefVarFl64xU0y(@ULTIMO/@Total)
DefVarFl64xU1y((@ULTIMO+1.0)/@Total)
ChamarxFps3DQuadPonto[@A,@B,@C,@U0,@V0]
DefVarVec3<Fl64>xPAy@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@C,@U1,@V0]
DefVarVec3<Fl64>xPBy@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@C,@U0,@V1]
DefVarVec3<Fl64>xPCy@ULTIMO
ChamarxFps3DTriUV[@UA,@UB,@UC,@U0,@V0]
DefVarVec2<Fl64>xTAy@ULTIMO
ChamarxFps3DTriUV[@UA,@UB,@UC,@U1,@V0]
DefVarVec2<Fl64>xTBy@ULTIMO
ChamarxFps3DTriUV[@UA,@UB,@UC,@U0,@V1]
DefVarVec2<Fl64>xTCy@ULTIMO
ChamarxFps3DTriAdicionar[@Visual,@Destino,@PA,@PB,@PC,@TA,@TB,@TC,@Material,@Andar,0,0,Verdadeiro]
DefVarInSd64xUltimay(@Colunas-1)
CompararMenorxyInSd64x@Xy@Ultima
Sex@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@C,@U1,@V1]
DefVarVec3<Fl64>xPDy@ULTIMO
ChamarxFps3DTriUV[@UA,@UB,@UC,@U1,@V1]
DefVarVec2<Fl64>xTDy@ULTIMO
ChamarxFps3DTriAdicionar[@Visual,@Destino,@PB,@PD,@PC,@TB,@TD,@TC,@Material,@Andar,0,0,Verdadeiro]
FimSe
FimPara
FimPara
FimFuncao
DefFuncaoxFps3DVisualPreparar[Registro<Fps3DMundo>xOrigem,SOA<FpsTriangulo>xCanonica,RefRegistro<Fps3DMundo>xVisual,RefSOA<FpsTriangulo>xDestino]yVazio
DefVarInSd64xNecessariosy0
ParaxI[0,@Origem.triangulos,1]
CompararIgualxyInSd32xCanonica@@I.partesUy0
Sex@ULTIMO
SetVarInSd64xNecessariosy(@Necessarios+1)
FimSe
CompararMaiorxyInSd32xCanonica@@I.partesUy0
Sex@ULTIMO
InSd32ParaInSd64[Canonica@@I.partesU]
DefVarInSd64xUy@ULTIMO
CompararMenorxyInSd32xCanonica@@I.partesVy0
Sex@ULTIMO
SetVarInSd64xNecessariosy(@Necessarios+@U*@U)
Senao
InSd32ParaInSd64[Canonica@@I.partesV]
SetVarInSd64xNecessariosy(@Necessarios+2*@U*@ULTIMO)
FimSe
FimSe
FimPara
SOAComprimento[@Destino]
CompararMaiorIgualxyInSd64x@ULTIMOy@Necessarios
Exigir[@ULTIMO]
SetVarRegistro<Fps3DMundo>xVisualy@Origem
SetVarInSd64xVisual.triangulosy0
ParaxI[0,@Origem.triangulos,1]
CompararMenorxyInSd32xCanonica@@I.partesUy0
Sex@ULTIMO
Continuar
FimSe
DefVarVec3<Fl64>xAy[Canonica@@I.ax,Canonica@@I.ay,Canonica@@I.az]
DefVarVec3<Fl64>xBy[Canonica@@I.bx,Canonica@@I.by,Canonica@@I.bz]
DefVarVec3<Fl64>xCy[Canonica@@I.cx,Canonica@@I.cy,Canonica@@I.cz]
CompararIgualxyInSd32xCanonica@@I.partesUy0
Sex@ULTIMO
ChamarxFps3DTriAdicionar[@Visual,@Destino,@A,@B,@C,[Canonica@@I.u0,Canonica@@I.v0],[Canonica@@I.u1,Canonica@@I.v1],[Canonica@@I.u2,Canonica@@I.v2],Canonica@@I.material,Canonica@@I.andar,Canonica@@I.movel,Canonica@@I.modo,Canonica@@I.solida]
Continuar
FimSe
CompararMenorxyInSd32xCanonica@@I.partesVy0
Sex@ULTIMO
InSd32ParaInSd64[Canonica@@I.partesU]
DefVarInSd64xPartesy@ULTIMO
ChamarxFps3DVisualTri[@Visual,@Destino,@A,@B,@C,[Canonica@@I.u0,Canonica@@I.v0],[Canonica@@I.u1,Canonica@@I.v1],[Canonica@@I.u2,Canonica@@I.v2],@Partes,Canonica@@I.material,Canonica@@I.andar]
Continuar
FimSe
DefVarInSd64xSeguintey(@I+1)
DefVarVec3<Fl64>xDy[Canonica@@Seguinte.cx,Canonica@@Seguinte.cy,Canonica@@Seguinte.cz]
InSd32ParaInSd64[Canonica@@I.partesU]
DefVarInSd64xColunasy@ULTIMO
InSd32ParaInSd64[Canonica@@I.partesV]
DefVarInSd64xLinhasy@ULTIMO
InSd64ParaFl64[@Colunas]
DefVarFl64xTotalUy@ULTIMO
InSd64ParaFl64[@Linhas]
DefVarFl64xTotalVy@ULTIMO
ParaxY[0,@Linhas,1]
InSd64ParaFl64[@Y]
DefVarFl64xV0y(@ULTIMO/@TotalV)
DefVarFl64xV1y((@ULTIMO+1.0)/@TotalV)
ParaxX[0,@Colunas,1]
InSd64ParaFl64[@X]
DefVarFl64xU0y(@ULTIMO/@TotalU)
DefVarFl64xU1y((@ULTIMO+1.0)/@TotalU)
ChamarxFps3DQuadPonto[@A,@B,@D,@U0,@V0]
DefVarVec3<Fl64>xPAy@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@D,@U1,@V0]
DefVarVec3<Fl64>xPBy@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@D,@U1,@V1]
DefVarVec3<Fl64>xPCy@ULTIMO
ChamarxFps3DQuadPonto[@A,@B,@D,@U0,@V1]
DefVarVec3<Fl64>xPDy@ULTIMO
ChamarxFps3DTriAdicionar[@Visual,@Destino,@PA,@PB,@PC,[@U0,(1.0-@V0)],[@U1,(1.0-@V0)],[@U1,(1.0-@V1)],Canonica@@I.material,Canonica@@I.andar,Canonica@@I.movel,Canonica@@I.modo,Canonica@@I.solida]
ChamarxFps3DTriAdicionar[@Visual,@Destino,@PA,@PC,@PD,[@U0,(1.0-@V0)],[@U1,(1.0-@V1)],[@U0,(1.0-@V1)],Canonica@@I.material,Canonica@@I.andar,Canonica@@I.movel,Canonica@@I.modo,Canonica@@I.solida]
FimPara
FimPara
FimPara
FimFuncao
