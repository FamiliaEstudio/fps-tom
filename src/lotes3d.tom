Importar[l'tom/listasdesenho']
// Listas comuns mantem a ordem; o adaptador GPU envia um unico buffer por quadro.
DefRegistroxFps3DLotes
PropInUd64xopaco
PropInUd64xtv
PropInUd64xmascara
PropInUd64xmistura
PropInUd64xhud
PropInUd64xnOpaco
PropInUd64xnTV
PropInUd64xnMascara
PropInUd64xnMistura
PropInUd64xnHud
PropInUd64xtotal
FimDef

DefFuncaoxFps3DLotesPreparar[BufferVec4Fl32xOpaco,BufferVec4Fl32xTV,BufferVec4Fl32xMascara,BufferVec4Fl32xMistura,BufferVec4Fl32xHud,RefBufferVec4Fl32xDestino]yRegistro<Fps3DLotes>
DefVarRegistro<Fps3DLotes>xRyPadrao
BufferVec4Fl32Comprimento[@Opaco]yR.nOpaco
BufferVec4Fl32Comprimento[@TV]yR.nTV
BufferVec4Fl32Comprimento[@Mascara]yR.nMascara
BufferVec4Fl32Comprimento[@Mistura]yR.nMistura
BufferVec4Fl32Comprimento[@Hud]yR.nHud
SetVarInUd64xR.tvy@R.nOpaco
SetVarInUd64xR.mascaray(@R.tv+@R.nTV)
SetVarInUd64xR.misturay(@R.mascara+@R.nMascara)
SetVarInUd64xR.hudy(@R.mistura+@R.nMistura)
SetVarInUd64xR.totaly(@R.hud+@R.nHud)
ChamarxListaDesenhoSeparados[@Opaco,@Destino]
ChamarxListaDesenhoSeparados[@TV,@Destino]
ChamarxListaDesenhoSeparados[@Mascara,@Destino]
ChamarxListaDesenhoSeparados[@Mistura,@Destino]
ChamarxListaDesenhoSeparados[@Hud,@Destino]
BufferVec4Fl32ValidarRedimensionamento[@Destino,@R.total]
BufferVec4Fl32ValidarRedimensionamento[@Destino,0]
BufferVec4Fl32Redimensionar[@Destino,0]
DefVarRegistro<FaixaDesenho>xFaixayPadrao
ChamarxListaDesenhoAnexar[@Opaco,@Destino]yFaixa
SetVarInUd64xR.opacoy@Faixa.inicio
ChamarxListaDesenhoAnexar[@TV,@Destino]yFaixa
SetVarInUd64xR.tvy@Faixa.inicio
ChamarxListaDesenhoAnexar[@Mascara,@Destino]yFaixa
SetVarInUd64xR.mascaray@Faixa.inicio
ChamarxListaDesenhoAnexar[@Mistura,@Destino]yFaixa
SetVarInUd64xR.misturay@Faixa.inicio
ChamarxListaDesenhoAnexar[@Hud,@Destino]yFaixa
SetVarInUd64xR.hudy@Faixa.inicio
Retornarx@R
FimFuncao
