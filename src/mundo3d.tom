// Marca a malha canônica sem mudar sua geometria ou suas consultas.
// A malha visual residente será preparada uma vez, antes do laço.
DefFuncaoxFps3DPartes[Vec3<Fl64>xA,Vec3<Fl64>xB]yInSd32
ChamarxFps3DSub[@B,@A]
ChamarxVetor3Fl64Comprimento[@ULTIMO]
DefVarFl64xComprimentoy@ULTIMO
DefVarInSd32xPartesy1
DefVarFl64xLimitey1.5
EnquantoxVerdadeiro
CompararMenorIgualxyFl64x@Comprimentoy@Limite
Sex@ULTIMO
Interromper
FimSe
SetVarInSd32xPartesy(@Partes+1)
SetVarFl64xLimitey(@Limite+1.5)
FimEnquanto
Retornarx@Partes
FimFuncao
DefFuncaoxFps3DQuadSubdividido[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC,Vec3<Fl64>xD,InSd32xMaterial,InSd32xAndar,InSd32xMovel,InSd32xModo,BlxSolida]yVazio
// Estes construtores produzem paralelogramos; rejeite forma que mudaria a superfície.
ChamarxFpsAbsoluto[(@C.x-@B.x-@D.x+@A.x)]
CompararMenorxyFl64x@ULTIMOy0.000000001
Exigir[@ULTIMO]
ChamarxFpsAbsoluto[(@C.y-@B.y-@D.y+@A.y)]
CompararMenorxyFl64x@ULTIMOy0.000000001
Exigir[@ULTIMO]
ChamarxFpsAbsoluto[(@C.z-@B.z-@D.z+@A.z)]
CompararMenorxyFl64x@ULTIMOy0.000000001
Exigir[@ULTIMO]
DefVarInSd64xInicioy@Mundo.triangulos
ChamarxFps3DQuad[@Mundo,@Malha,@A,@B,@C,@D,@Material,@Andar,@Movel,@Modo,@Solida]
CompararDiferentexyInSd32x@Movely0
Sex@ULTIMO
Retornar
FimSe
ChamarxFps3DPartes[@A,@B]
DefVarInSd32xUy@ULTIMO
ChamarxFps3DPartes[@A,@D]
DefVarInSd32xVy@ULTIMO
CompararMaiorxyInSd32x@Uy1
DefVarBlxDividiry@ULTIMO
CompararMaiorxyInSd32x@Vy1
OuxyBlx@Dividiry@ULTIMO
Sex@ULTIMO
SetVarInSd32xMalha@@Inicio.partesUy@U
SetVarInSd32xMalha@@Inicio.partesVy@V
DefVarInSd64xSeguintey(@Inicio+1)
SetVarInSd32xMalha@@Seguinte.partesUy-1
FimSe
FimFuncao
DefFuncaoxFps3DTriSubdividido[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC,Vec2<Fl64>xUA,Vec2<Fl64>xUB,Vec2<Fl64>xUC,InSd32xMaterial,InSd32xAndar]yVazio
DefVarInSd64xInicioy@Mundo.triangulos
ChamarxFps3DTriAdicionar[@Mundo,@Malha,@A,@B,@C,@UA,@UB,@UC,@Material,@Andar,0,0,Verdadeiro]
ChamarxFps3DPartes[@A,@B]
DefVarInSd32xPartesy@ULTIMO
ChamarxFps3DPartes[@A,@C]
CompararMaiorxyInSd32x@ULTIMOy@Partes
Sex@ULTIMO
ChamarxFps3DPartes[@A,@C]yPartes
FimSe
ChamarxFps3DPartes[@B,@C]
CompararMaiorxyInSd32x@ULTIMOy@Partes
Sex@ULTIMO
ChamarxFps3DPartes[@B,@C]yPartes
FimSe
CompararMaiorxyInSd32x@Partesy1
Sex@ULTIMO
SetVarInSd32xMalha@@Inicio.partesUy@Partes
SetVarInSd32xMalha@@Inicio.partesVy-1
FimSe
FimFuncao
DefFuncaoxFps3DCaixaSubdividida[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,InSd32xMaterial,InSd32xAndar,InSd32xMovel]yVazio
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@A.x,@B.y,@A.z],[@B.x,@B.y,@A.z],[@B.x,@A.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@A.x,@A.y,@B.z],[@B.x,@A.y,@B.z],[@B.x,@B.y,@B.z],[@A.x,@B.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@B.x,@A.y,@A.z],[@B.x,@A.y,@B.z],[@A.x,@A.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@A.x,@B.y,@A.z],[@A.x,@B.y,@B.z],[@B.x,@B.y,@B.z],[@B.x,@B.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@A.x,@A.y,@B.z],[@A.x,@B.y,@B.z],[@A.x,@B.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuadSubdividido[@Mundo,@Malha,[@B.x,@A.y,@A.z],[@B.x,@B.y,@A.z],[@B.x,@B.y,@B.z],[@B.x,@A.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
FimFuncao

// Moller-Trumbore sem culling: a mesma parede bloqueia pelos dois lados.
DefFuncaoxFps3DRaioTri[Vec3<Fl64>xO,Vec3<Fl64>xD,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC]yFl64
ChamarxFps3DSub[@B,@A]
DefVarVec3<Fl64>xE1y@ULTIMO
ChamarxFps3DSub[@C,@A]
DefVarVec3<Fl64>xE2y@ULTIMO
ChamarxVetor3Fl64ProdutoVetorial[@D,@E2]
DefVarVec3<Fl64>xHy@ULTIMO
ChamarxVetor3Fl64ProdutoEscalar[@E1,@H]
DefVarFl64xDety@ULTIMO
ChamarxFpsAbsoluto[@Det]
CompararMenorxyFl64x@ULTIMOy0.000000001
Sex@ULTIMO
Retornarx-1.0
FimSe
ChamarxFps3DSub[@O,@A]
DefVarVec3<Fl64>xSy@ULTIMO
ChamarxVetor3Fl64ProdutoEscalar[@S,@H]
DefVarFl64xUy(@ULTIMO/@Det)
CompararMenorxyFl64x@Uy-0.000000001
Sex@ULTIMO
Retornarx-1.0
FimSe
CompararMaiorxyFl64x@Uy1.000000001
Sex@ULTIMO
Retornarx-1.0
FimSe
ChamarxVetor3Fl64ProdutoVetorial[@S,@E1]
DefVarVec3<Fl64>xQy@ULTIMO
ChamarxVetor3Fl64ProdutoEscalar[@D,@Q]
DefVarFl64xVy(@ULTIMO/@Det)
CompararMenorxyFl64x@Vy-0.000000001
Sex@ULTIMO
Retornarx-1.0
FimSe
DefVarFl64xComparacao3D1y(@U+@V)
CompararMaiorxyFl64x@Comparacao3D1y1.000000001
Sex@ULTIMO
Retornarx-1.0
FimSe
ChamarxVetor3Fl64ProdutoEscalar[@E2,@Q]
DefVarFl64xTy(@ULTIMO/@Det)
CompararMenorxyFl64x@Ty0.0
Sex@ULTIMO
Retornarx-1.0
FimSe
Retornarx@T
FimFuncao
DefFuncaoxFps3DRaio[SOA<FpsCelula>xMapa,Registro<Fps3DMundo>xMundo,SOA<FpsTriangulo>xMalha,SOA<FpsElevador>xElevadores,Vec3<Fl64>xOrigem,Vec3<Fl64>xDirecao,Fl64xLimite]yRegistro<Fps3DContato>
DefVarRegistro<Fps3DContato>xRyPadrao
SetVarFl64xR.distanciay@Limite
SetVarInSd64xR.trianguloy-1
ParaxI[0,@Mundo.triangulos,1]
NaoBlxMalha@@I.solida
Sex@ULTIMO
Continuar
FimSe
ChamarxFps3DTriBounds[@Malha,@Elevadores,@Mapa,@I]
DefVarRegistro<Fps3DBB>xBoundsy@ULTIMO
ChamarxFps3DSegmentoBB[@Origem,@Direcao,@R.distancia,@Bounds.minimo,@Bounds.maximo]
NaoBlx@ULTIMO
Sex@ULTIMO
Continuar
FimSe
ChamarxFps3DTriPosicao[@Malha,@Elevadores,@Mapa,@I,0,1.0]
DefVarVec3<Fl64>xAy@ULTIMO
ChamarxFps3DTriPosicao[@Malha,@Elevadores,@Mapa,@I,1,1.0]
DefVarVec3<Fl64>xBy@ULTIMO
ChamarxFps3DTriPosicao[@Malha,@Elevadores,@Mapa,@I,2,1.0]
DefVarVec3<Fl64>xCy@ULTIMO
ChamarxFps3DRaioTri[@Origem,@Direcao,@A,@B,@C]
DefVarFl64xTy@ULTIMO
CompararMenorxyFl64x@Ty0.00001
Sex@ULTIMO
Continuar
FimSe
CompararMenorxyFl64x@Ty@R.distancia
Sex@ULTIMO
SetVarFl64xR.distanciay@T
SetVarInSd64xR.trianguloy@I
SetVarInSd32xR.movelyMalha@@I.movel
SetVarVec3<Fl64>xR.pontoy[(@Origem.x+@Direcao.x*@T),(@Origem.y+@Direcao.y*@T),(@Origem.z+@Direcao.z*@T)]
ChamarxFps3DSub[@B,@A]
DefVarVec3<Fl64>xE1y@ULTIMO
ChamarxFps3DSub[@C,@A]
ChamarxVetor3Fl64ProdutoVetorial[@E1,@ULTIMO]
ChamarxVetor3Fl64Normalizar[@ULTIMO]yR.normal
FimSe
FimPara
Retornarx@R
FimFuncao

DefFuncaoxFps3DPontoSegmento[Vec3<Fl64>xP,Vec3<Fl64>xA,Vec3<Fl64>xB]yVec3<Fl64>
