DefFuncaoxFps3DTriPosicao[SOA<FpsTriangulo>xMalha,SOA<FpsElevador>xElevadores,SOA<FpsCelula>xMapa,InSd64xIndice,InSd32xVertice,Fl64xAlpha]yVec3<Fl64>
DefVarVec3<Fl64>xPy[Malha@@Indice.ax,Malha@@Indice.ay,Malha@@Indice.az]
CompararIgualxyInSd32x@Verticey1
Sex@ULTIMO
SetVarVec3<Fl64>xPy[Malha@@Indice.bx,Malha@@Indice.by,Malha@@Indice.bz]
FimSe
CompararIgualxyInSd32x@Verticey2
Sex@ULTIMO
SetVarVec3<Fl64>xPy[Malha@@Indice.cx,Malha@@Indice.cy,Malha@@Indice.cz]
FimSe
DefVarInSd32xMovelyMalha@@Indice.movel
CompararMaiorxyInSd32x@Movely0
Sex@ULTIMO
InSd32ParaInSd64[(@Movel-1)]
DefVarInSd64xIy@ULTIMO
DefVarFl64xDeltay(Mapa@@I.anterior+(Mapa@@I.abertura-Mapa@@I.anterior)*@Alpha)
CompararIgualxyInSd32xMapa@@I.eixoy0
Sex@ULTIMO
SetVarFl64xP.yy(@P.y+@Delta)
Senao
SetVarFl64xP.xy(@P.x+@Delta)
FimSe
FimSe
CompararMenorxyInSd32x@Movely0
Sex@ULTIMO
InSd32ParaInSd64[(-@Movel-1)]
DefVarInSd64xIy@ULTIMO
SetVarFl64xP.zy(@P.z+Elevadores@@I.anteriorZ+(Elevadores@@I.pz-Elevadores@@I.anteriorZ)*@Alpha)
FimSe
Retornarx@P
FimFuncao

DefFuncaoxFps3DTriAdicionar[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC,Vec2<Fl64>xUA,Vec2<Fl64>xUB,Vec2<Fl64>xUC,InSd32xMaterial,InSd32xAndar,InSd32xMovel,InSd32xModo,BlxSolida]yVazio
DefVarInSd64xIy@Mundo.triangulos
SOAComprimento[@Malha]
CompararMenorxyInSd64x@Iy@ULTIMO
Exigir[@ULTIMO]
SetVarFl64xMalha@@I.axy@A.x
SetVarFl64xMalha@@I.ayy@A.y
SetVarFl64xMalha@@I.azy@A.z
SetVarFl64xMalha@@I.bxy@B.x
SetVarFl64xMalha@@I.byy@B.y
SetVarFl64xMalha@@I.bzy@B.z
SetVarFl64xMalha@@I.cxy@C.x
SetVarFl64xMalha@@I.cyy@C.y
SetVarFl64xMalha@@I.czy@C.z
SetVarFl64xMalha@@I.u0y@UA.x
SetVarFl64xMalha@@I.v0y@UA.y
SetVarFl64xMalha@@I.u1y@UB.x
SetVarFl64xMalha@@I.v1y@UB.y
SetVarFl64xMalha@@I.u2y@UC.x
SetVarFl64xMalha@@I.v2y@UC.y
ChamarxFps3DMin[@A.x,@B.x]
ChamarxFps3DMin[@ULTIMO,@C.x]
DefVarFl64xMinXy@ULTIMO
ChamarxFps3DMin[@A.y,@B.y]
ChamarxFps3DMin[@ULTIMO,@C.y]
DefVarFl64xMinYy@ULTIMO
ChamarxFps3DMin[@A.z,@B.z]
ChamarxFps3DMin[@ULTIMO,@C.z]
SetVarVec3<Fl64>xMalha@@I.minimoy[@MinX,@MinY,@ULTIMO]
ChamarxFps3DMax[@A.x,@B.x]
ChamarxFps3DMax[@ULTIMO,@C.x]
DefVarFl64xMaxXy@ULTIMO
ChamarxFps3DMax[@A.y,@B.y]
ChamarxFps3DMax[@ULTIMO,@C.y]
DefVarFl64xMaxYy@ULTIMO
ChamarxFps3DMax[@A.z,@B.z]
ChamarxFps3DMax[@ULTIMO,@C.z]
SetVarVec3<Fl64>xMalha@@I.maximoy[@MaxX,@MaxY,@ULTIMO]
SetVarInSd32xMalha@@I.materialy@Material
SetVarInSd32xMalha@@I.andary@Andar
SetVarInSd32xMalha@@I.movely@Movel
SetVarInSd32xMalha@@I.modoy@Modo
SetVarBlxMalha@@I.soliday@Solida
SetVarInSd32xMalha@@I.partesUy0
SetVarInSd32xMalha@@I.partesVy0
SetVarInSd64xMundo.triangulosy(@I+1)
FimFuncao
DefFuncaoxFps3DQuad[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC,Vec3<Fl64>xD,InSd32xMaterial,InSd32xAndar,InSd32xMovel,InSd32xModo,BlxSolida]yVazio
ChamarxFps3DTriAdicionar[@Mundo,@Malha,@A,@B,@C,[0.0,1.0],[1.0,1.0],[1.0,0.0],@Material,@Andar,@Movel,@Modo,@Solida]
ChamarxFps3DTriAdicionar[@Mundo,@Malha,@A,@C,@D,[0.0,1.0],[1.0,0.0],[0.0,0.0],@Material,@Andar,@Movel,@Modo,@Solida]
