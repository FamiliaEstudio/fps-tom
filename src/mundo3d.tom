PropIn32xandar
// 0 estatico, indiceCelula+1 porta, -(indiceElevador+1) elevador.
PropIn32xmovel
PropIn32xmodo
PropBlxsolida
// Tesselação visual opt-in; -1 marca o segundo triângulo de um quad.
PropIn32xpartesU
PropIn32xpartesV
FimDef
