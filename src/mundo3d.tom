// Ponto mais proximo numa face: projecao interior ou uma de suas arestas.
DefFuncaoxFps3DPontoTri[Vec3<Fl64>xP,Vec3<Fl64>xA,Vec3<Fl64>xB,Vec3<Fl64>xC]yVec3<Fl64>
ChamarxFps3DSub[@B,@A]
DefVarVec3<Fl64>xE1y@ULTIMO
ChamarxFps3DSub[@C,@A]
DefVarVec3<Fl64>xE2y@ULTIMO
ChamarxVetor3Fl64ProdutoVetorial[@E1,@E2]
DefVarVec3<Fl64>xNy@ULTIMO
ChamarxVetor3Fl64ProdutoEscalar[@N,@N]
DefVarFl64xNNy@ULTIMO
CompararMaiorxyFl64x@NNy0.000000001
Sex@ULTIMO
ChamarxFps3DSub[@P,@A]
ChamarxVetor3Fl64ProdutoEscalar[@ULTIMO,@N]
DefVarFl64xDy(@ULTIMO/@NN)
DefVarVec3<Fl64>xQy[(@P.x-@N.x*@D),(@P.y-@N.y*@D),(@P.z-@N.z*@D)]
