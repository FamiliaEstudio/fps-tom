DefFuncaoxFps3DCaixa[RefRegistro<Fps3DMundo>xMundo,RefSOA<FpsTriangulo>xMalha,Vec3<Fl64>xA,Vec3<Fl64>xB,InSd32xMaterial,InSd32xAndar,InSd32xMovel]yVazio
ChamarxFps3DQuad[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@A.x,@B.y,@A.z],[@B.x,@B.y,@A.z],[@B.x,@A.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuad[@Mundo,@Malha,[@A.x,@A.y,@B.z],[@B.x,@A.y,@B.z],[@B.x,@B.y,@B.z],[@A.x,@B.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuad[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@B.x,@A.y,@A.z],[@B.x,@A.y,@B.z],[@A.x,@A.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuad[@Mundo,@Malha,[@A.x,@B.y,@A.z],[@A.x,@B.y,@B.z],[@B.x,@B.y,@B.z],[@B.x,@B.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuad[@Mundo,@Malha,[@A.x,@A.y,@A.z],[@A.x,@A.y,@B.z],[@A.x,@B.y,@B.z],[@A.x,@B.y,@A.z],@Material,@Andar,@Movel,0,Verdadeiro]
ChamarxFps3DQuad[@Mundo,@Malha,[@B.x,@A.y,@A.z],[@B.x,@B.y,@A.z],[@B.x,@B.y,@B.z],[@B.x,@A.y,@B.z],@Material,@Andar,@Movel,0,Verdadeiro]
