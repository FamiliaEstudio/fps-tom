DefVarInSd64xIYy@ULTIMO
DefVarInSd64xIXy(@Indice - @IY * 32)
InSd64ParaFl64[@IX]yC.esquerda
InSd64ParaFl64[@IY]yC.cima
SetVarFl64xC.direitay(@C.esquerda + 1.0)
SetVarFl64xC.baixoy(@C.cima + 1.0)
SetVarInSd32xC.eixoyMapa@@Indice.eixo
SetVarFl64xC.deslocamentoy@Abertura
CompararMenorxyFl64x@Aberturay1.0
Sex@ULTIMO
SetVarInSd32xC.materialy(4 + Mapa@@Indice.chave)
FimSe
CompararIgualxyInSd32x@C.eixoy0
Sex@ULTIMO
SetVarFl64xC.direitay(@C.esquerda + 0.5625)
SetVarFl64xC.esquerday(@C.esquerda + 0.4375)
SetVarFl64xC.cimay(@C.cima + @Abertura)
Senao
SetVarFl64xC.baixoy(@C.cima + 0.5625)
SetVarFl64xC.cimay(@C.cima + 0.4375)
SetVarFl64xC.esquerday(@C.esquerda + @Abertura)
FimSe
Retornarx@C
FimFuncao

