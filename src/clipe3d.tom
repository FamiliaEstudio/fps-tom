// Perfil compilavel preparado junto ao atlas; nenhum codec ou JSON no laco.
Importar[l'tom/animacao']
DefRegistroxFpsClipe3D
PropInSd64xlargura
PropInSd64xaltura
PropInSd64xtaxa
PropInSd64xquadros
PropInSd64xcolunas
PropInSd64xlinhas
PropInSd64xduracaoAmostras
PropBlxaudio
FimDef

DefFuncaoxFpsClipePadrao[]yRegistro<FpsClipe3D>
DefVarRegistro<FpsClipe3D>xRyPadrao
SetVarInSd64xR.larguray128
SetVarInSd64xR.alturay96
SetVarInSd64xR.taxay12
SetVarInSd64xR.quadrosy96
SetVarInSd64xR.colunasy8
SetVarInSd64xR.linhasy12
SetVarInSd64xR.duracaoAmostrasy384000
SetVarBlxR.audioyVerdadeiro
Retornarx@R
FimFuncao

DefFuncaoxFpsClipeValidar[Registro<FpsClipe3D>xClipe,InUd32xLarguraAtlas,InUd32xAlturaAtlas]yVazio
CompararMaiorIgualxyInSd64x@Clipe.larguray1
Exigir[@ULTIMO]
CompararMenorIgualxyInSd64x@Clipe.larguray128
Exigir[@ULTIMO]
CompararMaiorIgualxyInSd64x@Clipe.alturay1
Exigir[@ULTIMO]
CompararMenorIgualxyInSd64x@Clipe.alturay96
Exigir[@ULTIMO]
CompararMaiorIgualxyInSd64x@Clipe.taxay1
Exigir[@ULTIMO]
CompararMenorIgualxyInSd64x@Clipe.taxay30
Exigir[@ULTIMO]
DefVarInSd64xRestoy(48000-48000/@Clipe.taxa*@Clipe.taxa)
CompararIgualxyInSd64x@Restoy0
Exigir[@ULTIMO]
CompararMaiorIgualxyInSd64x@Clipe.quadrosy1
Exigir[@ULTIMO]
DefVarInSd64xMaximoQuadrosy(@Clipe.taxa*8)
CompararMenorIgualxyInSd64x@Clipe.quadrosy@MaximoQuadros
Exigir[@ULTIMO]
CompararMaiorIgualxyInSd64x@Clipe.colunasy1
Exigir[@ULTIMO]
CompararMenorIgualxyInSd64x@Clipe.colunasy8
Exigir[@ULTIMO]
CompararMenorIgualxyInSd64x@Clipe.colunasy@Clipe.quadros
Exigir[@ULTIMO]
DefVarInSd64xLinhasEsperadasy((@Clipe.quadros+@Clipe.colunas-1)/@Clipe.colunas)
CompararIgualxyInSd64x@Clipe.linhasy@LinhasEsperadas
Exigir[@ULTIMO]
DefVarInSd64xDuracaoEsperaday(@Clipe.quadros*(48000/@Clipe.taxa))
CompararIgualxyInSd64x@Clipe.duracaoAmostrasy@DuracaoEsperada
Exigir[@ULTIMO]
InUd32ParaInSd64[@LarguraAtlas]
DefVarInSd64xLarguraAtualy@ULTIMO
DefVarInSd64xLarguraEsperaday(@Clipe.largura*@Clipe.colunas)
CompararIgualxyInSd64x@LarguraAtualy@LarguraEsperada
Exigir[@ULTIMO]
InUd32ParaInSd64[@AlturaAtlas]
DefVarInSd64xAlturaAtualy@ULTIMO
DefVarInSd64xAlturaEsperaday(@Clipe.altura*@Clipe.linhas)
CompararIgualxyInSd64x@AlturaAtualy@AlturaEsperada
Exigir[@ULTIMO]
FimFuncao

DefFuncaoxFpsClipeQuadro[Registro<FpsClipe3D>xClipe,InSd64xAmostra]yInSd64
ChamarxAnimacaoQuadro[@Amostra,(48000/@Clipe.taxa),@Clipe.quadros,Verdadeiro]
Retornarx@ULTIMO
FimFuncao

DefFuncaoxFpsClipeRelogio[Registro<FpsClipe3D>xClipe,InSd64xPassos,InSd64xAmostrasAudio]yInSd64
Sex@Clipe.audio
Retornarx@AmostrasAudio
FimSe
Retornarx(@Passos*800)
FimFuncao
